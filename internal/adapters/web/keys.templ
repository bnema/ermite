package web

// Keys is the keyboard map. ermite.js turns keys into k-<name> events on
// <body>; this element is the only place that binds them, each to one call of
// window.ermite (ermite.js), which does the work.
templ Keys() {
	<div
		id="keys"
		hidden
		hx-on="k-j from:body -> ermite.move(1);
         k-k from:body -> ermite.move(-1);
         k-top from:body -> ermite.edge(false);
         k-bottom from:body -> ermite.edge(true);
         k-open from:body -> ermite.open();
         k-right from:body -> ermite.rail(true);
         k-left from:body -> ermite.rail(false);
         k-esc from:body -> ermite.closeDialogs();
         k-help from:body -> ermite.dialog('panel-help');
         k-refs from:body -> ermite.dialog('panel-refs', 'refs-filter');
         k-cmd from:body -> ermite.dialog('panel-cmd', 'cmd-q'); ermiteFinder.load();
         k-filter from:body -> ermite.focusFilter();
         k-gh from:body -> ermite.go('.brand');
         k-s from:body -> ermite.tab('s');
         k-t from:body -> ermite.tab('t');
         k-c from:body -> ermite.tab('c');
         k-r from:body -> ermite.tab('r');
         k-m from:body -> ermite.tab('m');
         k-next from:body -> ermite.nextNote();
         k-split from:body -> ermite.layout('split');
         k-unified from:body -> ermite.layout('unified');
         k-collapse from:body -> ermite.collapse();
         k-expand from:body -> ermite.expandFile();
         k-expandAll from:body -> ermite.expandAll();
         k-permalink from:body -> ermite.permalink();
         k-merge from:body -> window.ermiteMR?.openMerge();
         k-read from:body -> window.ermiteMR?.markRead();
         k-gf from:body -> window.ermiteMR?.focusFiles();
         k-keys from:body -> ermite.toggleKeys()"
	></div>
}
