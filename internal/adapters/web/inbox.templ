package web

// Inbox is the owner's inbox: what is open across every repository. The
// counters, the filter and the lists are fragments with an id that the live
// stream replaces as a whole (ermiteLive.swap).
templ Inbox(l Layout, p InboxPage) {
	@Shell(l, nil) {
		<h1 class="sr">Inbox</h1>
		<div class="inbox">
			@InboxCounters(p)
			@InboxRepos(p)
			@InboxPending(p)
			@InboxRuns(p)
			@InboxMRs(p)
			@InboxIssues(p)
		</div>
	}
}

templ InboxCounters(p InboxPage) {
	<p id="inbox-counts" class="inbox-counts">
		<strong>{ itoa(p.MergeRequests) }</strong> merge requests · <strong>{ itoa(p.Issues) }</strong> issues · <strong>{ itoa(p.PendingCount) }</strong> awaiting moderation · <strong>{ itoa(p.Running) }</strong> running
	</p>
}

templ InboxRepos(p InboxPage) {
	<nav id="inbox-repos" class="since" aria-label="Repository">
		for _, r := range p.Repos {
			<a
				href={ templ.SafeURL(r.Href) }
				if r.Current {
					aria-current="page"
				}
			>{ r.Label }</a>
		}
	</nav>
}

// InboxPending is the issues awaiting moderation, first on the page. Their
// texts come from anonymous visitors: they are shown as plain text, escaped,
// never as Markdown.
templ InboxPending(p InboxPage) {
	<section id="inbox-pending" aria-labelledby="inbox-pending-h">
		<h2 id="inbox-pending-h" class="rule-h"><span>Awaiting moderation</span><span class="count">{ itoa(p.PendingCount) }</span></h2>
		if len(p.Pending) > 0 {
			<ul class="pending-list">
				for _, m := range p.Pending {
					<li class="pending">
						<div class="p-head">
							<a href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a>
							<span>{ m.Author }</span>
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</div>
						<p class="p-title">{ m.Title }</p>
						if m.Preview != "" {
							<p class="p-body">{ m.Preview }</p>
						}
						if m.Approve != "" {
							<div class="p-btns">
								<form method="post" action={ templ.SafeURL(m.Approve) }><button type="submit" class="btn primary">Approve</button></form>
								<form method="post" action={ templ.SafeURL(m.Reject) }><button type="submit" class="btn">Reject</button></form>
								<form method="post" action={ templ.SafeURL(m.Ban) }><button type="submit" class="btn danger">Reject and ban</button></form>
							</div>
						}
					</li>
				}
			</ul>
		} else {
			<p class="lede dim">nothing awaits moderation.</p>
		}
	</section>
}

templ InboxMRs(p InboxPage) {
	<section id="inbox-mrs" aria-labelledby="inbox-mrs-h">
		<h2 id="inbox-mrs-h" class="rule-h"><span>Open merge requests</span><span class="count">{ itoa(len(p.MRs)) }</span></h2>
		@inboxRows(p.MRs, "Open merge requests")
		if len(p.MRs) == 0 {
			<p class="lede dim">no open merge requests.</p>
		}
	</section>
}

templ InboxIssues(p InboxPage) {
	<section id="inbox-issues" aria-labelledby="inbox-issues-h">
		<h2 id="inbox-issues-h" class="rule-h"><span>Open issues</span><span class="count">{ itoa(len(p.IssueRows)) }</span></h2>
		@inboxRows(p.IssueRows, "Open issues")
		if len(p.IssueRows) == 0 {
			<p class="lede dim">no open issues.</p>
		}
	</section>
}

templ inboxRows(rows []InboxRow, label string) {
	if len(rows) > 0 {
		<table class="list mrs" aria-label={ label }>
			<tbody data-rows>
				for _, m := range rows {
					<tr data-cursor?={ m.Cursor } data-state="open">
						<td class="c-n mute">{ m.Number }</td>
						<td class="c-subject"><a href={ templ.SafeURL(m.Href) }>{ m.Title }</a> <a class="mute" href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a></td>
						<td class="c-when nowrap dim">
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// InboxRuns stays as an empty fragment when CI is disabled.
templ InboxRuns(p InboxPage) {
	<section id="inbox-runs" hidden?={ !p.RunsEnabled }
        if p.RunsEnabled {
            aria-labelledby="inbox-runs-h"
        }
    >
		if p.RunsEnabled {
			<h2 id="inbox-runs-h" class="rule-h"><span>Running</span><span class="count">{ itoa(len(p.Runs)) }</span></h2>
			if len(p.Runs) == 0 {
				<p class="lede dim">no runs in progress.</p>
			} else {
				<table class="list mrs" aria-label="Running">
					<tbody data-rows>
						for _, r := range p.Runs {
							<tr>
								<td class="c-st">@CheckIcon(r.Kind, r.State)<span class="dim">{ r.State }</span></td>
								<td class="c-subject"><a href={ templ.SafeURL(r.Href) }>{ r.Workflow }{ " " }{ r.Number }</a> <a class="mute" href={ templ.SafeURL(r.RepoHref) }>{ r.Repo }</a> <span class="dim">{ r.Ref }{ " " }{ r.Event }</span></td>
								<td class="c-when nowrap dim">
									if r.WhenAt != "" {
										<time datetime={ r.WhenAt } title={ r.WhenAt }>{ r.When }</time>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</section>
}
