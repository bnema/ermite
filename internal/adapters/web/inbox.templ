package web

// Inbox is the owner's inbox. The live stream replaces its content as a whole.
templ Inbox(l Layout, p InboxPage) {
	@Shell(l, nil) {
		<h1 class="sr">Inbox</h1>
		@InboxContent(p)
	}
}

templ InboxContent(p InboxPage) {
	<div id="inbox-content" class="inbox" data-keep-open>
		<nav class="tabs" aria-label="Inbox sections">
			<ul>
				for _, t := range p.Tabs {
					<li><a
	href={ templ.SafeURL(t.Href) }
	if t.Current {
		aria-current="page"
	}
>{ t.Label }</a></li>
				}
			</ul>
		</nav>
		switch p.Tab {
			case "deps":
				@InboxDeps(p)
			case "activity":
				@InboxRuns(p)
				@InboxJournal(p)
			case "moderation":
				@InboxPending(p)
			default:
				@InboxMRs(p)
				@InboxIssues(p)
		}
	</div>
}

// InboxJournal is the activity of the range, newest first: the repositories
// whose default branch is ahead of their nearest tag, then one row per entry.
// Plain lines and a plain table, like the other sections.
templ InboxJournal(p InboxPage) {
	{{ j := p.Journal }}
	<section id="inbox-journal" class="journal" aria-labelledby="inbox-journal-h">
		<div class="journal-head">
			<h2 id="inbox-journal-h" class="rule-h"><span>Activity</span><span class="journal-count">{ itoa(len(j.Rows)) }</span></h2>
			<nav class="journal-range" aria-label="Activity range">
				for i, r := range j.Ranges {
					<a
						href={ templ.SafeURL(r.Href) }
						if r.Current {
							aria-current="page"
						}
					>{ r.Label }</a>
					if i < len(j.Ranges)-1 {
						<span class="mute" aria-hidden="true">·</span>
					}
				}
			</nav>
		</div>
		if len(j.Unreleased) > 0 {
			<ul class="unreleased" aria-label="Unreleased commits">
				for _, u := range j.Unreleased {
					<li>
						<span class="u-mark" aria-hidden="true">⚠</span>
						<a class="u-repo" href={ templ.SafeURL(u.RepoHref) }>{ u.Repo }</a>
						<span class="mute">—</span>
						<a class="num" href={ templ.SafeURL(u.CommitsHref) }>{ u.Commits }</a>
						if u.Tag != "" {
							<span class="dim">since</span> <a class="u-tag" href={ templ.SafeURL(u.TagHref) }>{ u.Tag }</a>
							if u.WhenAt != "" {
								<span class="mute">·</span> <time class="dim" datetime={ u.WhenAt } title={ u.Title }>{ u.When }</time>
							}
						} else {
							<span class="dim">since the last tag</span>
						}
					</li>
				}
			</ul>
		}
		if len(j.Rows) > 0 {
			<table class="list journal-list" aria-label="Activity">
				<thead><tr><th>When</th><th>Repository</th><th>Type</th><th class="c-main">Detail</th><th class="c-who">Actor</th></tr></thead>
				<tbody>
					for _, r := range j.Rows {
						<tr data-kind={ r.Kind }>
							<td class="c-when nowrap dim">
								if r.WhenAt != "" {
									<time datetime={ r.WhenAt } title={ r.Title }>{ r.When }</time>
								}
							</td>
							<td class="c-repo"><a href={ templ.SafeURL(r.RepoHref) }>{ r.Repo }</a></td>
							<td class="c-kind"><span class="j-kind">{ r.Label }</span></td>
							<td class="c-main">
								if r.Href != "" {
									<a href={ templ.SafeURL(r.Href) }><span class="j-ref">{ r.Ref }</span> { r.Text }</a>
								} else {
									<span class="j-ref">{ r.Ref }</span> { r.Text }
								}
								if r.Note != "" {
									<span class="mute num">· { r.Note }</span>
								}
							</td>
							<td class="c-who mute">{ r.Actor }</td>
						</tr>
					}
				</tbody>
			</table>
			if j.Truncated {
				<p class="mute journal-more">only the latest { itoa(len(j.Rows)) } entries are shown.</p>
			}
		} else {
			<p class="lede dim">no activity in the last { j.RangeLabel }.</p>
		}
	</section>
}

// InboxPending is the issues awaiting moderation, first on the page. Their
// texts come from anonymous visitors: they are shown as plain text, escaped,
// never as Markdown.
templ InboxPending(p InboxPage) {
	<section id="inbox-pending" aria-labelledby="inbox-pending-h">
		<h2 id="inbox-pending-h" class="rule-h"><span>Awaiting moderation</span><span id="inbox-pending-count" class="count">{ itoa(p.PendingCount) }</span></h2>
		if len(p.Pending) > 0 {
			<ul class="pending-list">
				for _, m := range p.Pending {
					<li class="pending" id={ m.ID }>
						<div class="p-head">
							<a href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a>
							<span>{ m.Author }</span>
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</div>
						<p class="p-title">{ m.Title }</p>
						if m.Preview != "" {
							<p class="p-body">{ m.Preview }</p>
						}
						if m.Approve != "" {
							<div class="p-btns">
								@ActionForm(ActionProps{Action: m.Approve}) {
									<button type="submit" class="btn primary">Approve</button>
								}
								@ActionForm(ActionProps{Action: m.Reject}) {
									<button type="submit" class="btn">Reject</button>
								}
								@ActionForm(ActionProps{Action: m.Ban, Confirm: "Reject and ban this author?"}) {
									<button type="submit" class="btn danger">Reject and ban</button>
								}
							</div>
						}
					</li>
				}
			</ul>
		} else {
			<p class="lede dim">nothing awaits moderation.</p>
		}
	</section>
}

templ InboxMRs(p InboxPage) {
	<section id="inbox-mrs" aria-labelledby="inbox-mrs-h">
		<h2 id="inbox-mrs-h" class="rule-h"><span>Open merge requests</span><span class="count">{ itoa(len(p.MRs)) }</span></h2>
		@inboxRows(p.MRs, "Open merge requests")
		if len(p.MRs) == 0 {
			<p class="lede dim">no open merge requests.</p>
		}
	</section>
}

templ InboxIssues(p InboxPage) {
	<section id="inbox-issues" aria-labelledby="inbox-issues-h">
		<h2 id="inbox-issues-h" class="rule-h"><span>Open issues</span><span class="count">{ itoa(len(p.IssueRows)) }</span></h2>
		@inboxRows(p.IssueRows, "Open issues")
		if len(p.IssueRows) == 0 {
			<p class="lede dim">no open issues.</p>
		}
	</section>
}

templ inboxRows(rows []InboxRow, label string) {
	if len(rows) > 0 {
		<table class="list mrs" aria-label={ label }>
			<tbody data-rows>
				for _, m := range rows {
					<tr data-cursor?={ m.Cursor } data-state="open">
						<td class="c-n mute">{ m.Number }</td>
						<td class="c-subject"><a href={ templ.SafeURL(m.Href) }>{ m.Title }</a> <a class="mute" href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a></td>
						<td class="c-ck">@CommitChecks(m.Checks)</td>
						<td class="c-when nowrap dim">
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// InboxRuns stays as an empty fragment when CI is disabled.
templ InboxRuns(p InboxPage) {
	<section
		id="inbox-runs"
		hidden?={ !p.RunsEnabled }
		if p.RunsEnabled {
			aria-labelledby="inbox-runs-h"
		}
	>
		if p.RunsEnabled {
			<h2 id="inbox-runs-h" class="rule-h"><span>Running</span><span class="count">{ itoa(len(p.Runs)) }</span></h2>
			if len(p.Runs) == 0 {
				<p class="lede dim">no runs in progress.</p>
			} else {
				<table class="list mrs" aria-label="Running">
					<tbody data-rows>
						for _, r := range p.Runs {
							<tr>
								<td class="c-st">@CheckIcon(r.Kind, r.State)<span class="dim">{ r.State }</span></td>
								<td class="c-subject"><a href={ templ.SafeURL(r.Href) }>{ r.Workflow }{ " " }{ r.Number }</a> <a class="mute" href={ templ.SafeURL(r.RepoHref) }>{ r.Repo }</a> <span class="dim">{ r.Ref }{ " " }{ r.Event }</span></td>
								<td class="c-when nowrap dim">
									if r.WhenAt != "" {
										<time datetime={ r.WhenAt } title={ r.WhenAt }>{ r.When }</time>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</section>
}

// InboxDeps is Bernard's table: one collapsible row per repository, its patch
// and minor batch first, then its major families, each with its status and
// actions. It stays as an empty fragment when there is nothing to show.
// data-keep-open: the live swap keeps the open rows open, and closed ones
// closed.
templ InboxDeps(p InboxPage) {
	<section
		id="inbox-deps"
		data-keep-open
		hidden?={ p.DepsBatches == 0 }
		if p.DepsBatches > 0 {
			aria-labelledby="inbox-deps-h"
		}
	>
		if p.DepsBatches > 0 {
			@inboxDepsHeader(p)
			<div class="deps-bar">
				<nav class="deps-filters" aria-label="Filter batches">
					for _, f := range p.DepsFilters {
						<a
							class="btn deps-chip"
							href={ templ.SafeURL(f.Href) }
							if f.Current {
								aria-current="page"
							}
						>
							{ f.Label }
							if f.Label != "All" {
								{ " " }<span class="count">{ itoa(f.Count) }</span>
							}
						</a>
					}
				</nav>
				<nav class="deps-sort" aria-label="Sort repositories">
					<span class="mute">sort:</span>
					for i, o := range p.DepsSorts {
						<a
							href={ templ.SafeURL(o.Href) }
							if o.Current {
								aria-current="page"
							}
						>{ o.Label }</a>
						if i < len(p.DepsSorts)-1 {
							<span class="mute" aria-hidden="true">·</span>
						}
					}
				</nav>
			</div>
			if len(p.Deps) == 0 {
				<p class="dim deps-none">no batch matches this filter.</p>
			} else {
				<ul class="deps-repos">
					for _, r := range p.Deps {
						@inboxDepsRepo(r)
					}
				</ul>
			}
		}
	</section>
}

// inboxDepsHeader is the title of the table with the last check and the
// queue; #inbox-deps-meta is swapped after an action.
templ inboxDepsHeader(p InboxPage) {
<h2 id="inbox-deps-h" class="rule-h">
	<span>Dependency updates</span>
	<span id="inbox-deps-meta" class="dim">
		if p.DepsCheckedAt != "" {
			checked <time datetime={ p.DepsCheckedAt }>{ p.DepsChecked }</time> ·{ " " }
		}
		{ plural(p.DepsBatches, "batch", "batches") } · { plural(p.DepsUpdates, "update", "updates") }
		if p.DepsQueue != "" {
			{ " · " }<span class="deps-queue">{ p.DepsQueue }</span>
		}
	</span>
</h2>
}

// depsStatusCell is the state of the batch: its run or its place in the
// queue, and its merge request.
templ depsStatusCell(s InboxDepsStatus) {
	if s.State != "" {
		<span class="deps-state">
			<span aria-hidden="true">
				@CheckIcon(depsIconKind(s), s.State)
			</span>
			<span class="dim">{ s.State }</span>
			if s.Href != "" {
				<a href={ templ.SafeURL(s.Href) }>{ s.Text }</a>
			}
		</span>
	}
	if s.MR != 0 {
		<span class="deps-mr">
			<a href={ templ.SafeURL(s.MRHref) }>MR !{ itoa64(s.MR) }</a>
			if s.Draft {
				<span class="pill">draft</span>
			}
			if s.Adopted {
				<span class="pill" title="a human pushed to the branch: Bernard leaves it alone">adopted</span>
			}
		</span>
	}
}

// depsForm is one POST button of a row. The expected versions go in hidden
// fields (four per update, in the same order) for Open MR and Ignore.
templ depsForm(d InboxDepsRow, action, label, class string, refs bool, id string) {
	@ActionForm(ActionProps{Action: action}) {
		if refs {
			<input type="hidden" name="batch" value={ d.Batch }/>
			for _, u := range d.Updates {
				<input type="hidden" name="ecosystem" value={ u.Ecosystem }/>
				<input type="hidden" name="directory" value={ u.Directory }/>
				<input type="hidden" name="name" value={ u.Name }/>
				<input type="hidden" name="version" value={ u.Latest }/>
			}
		}
		<button
			type="submit"
			class={ class }
			if id != "" {
				id={ id }
			}
		>{ label }</button>
	}
}

// depsFieldForm is a POST button with one fixed field.
templ depsFieldForm(action, field, value, label string) {
	@ActionForm(ActionProps{Action: action}) {
		<input type="hidden" name={ field } value={ value }/>
		<button type="submit" class="btn">{ label }</button>
	}
}

// depsRepoSummary is the line of a repository: failures, counts, and the
// state of its patch and minor batch.
templ depsRepoSummary(r InboxDepsRepo) {
	<span class="deps-repo">{ r.Repo }</span>
	if r.Failed > 0 {
		<span class="deps-failed">
			<span aria-hidden="true">
				@CheckIcon("bad", "failed")
			</span>
			{ itoa(r.Failed) } failed
		</span>
	}
	if r.Base != nil {
		<span class="dim">{ itoa(r.BaseCount) } patch/minor</span>
		if r.Base.Status.MR != 0 {
			<span class="dim">MR !{ itoa64(r.Base.Status.MR) }</span>
		} else if r.Base.Status.State != "" && r.Base.Status.Kind != "failed" {
			<span class="dim">{ r.Base.Status.State }</span>
		}
	}
	if r.MajorCount > 0 {
		<span class="dim">{ plural(r.MajorCount, "major", "majors") }</span>
	}
	if r.New > 0 {
		<span class="pill deps-new">new { itoa(r.New) }</span>
	}
	<span class="sr">{ ", " + plural(r.Count, "update", "updates") }</span>
}

templ inboxDepsRepo(r InboxDepsRepo) {
	<li class="deps-repo-row" id={ r.ID } data-failed?={ r.Failed > 0 }>
		<details class="deps-main" open?={ r.Open }>
			<summary id={ r.ID + "-sum" }>
				@depsRepoSummary(r)
			</summary>
			<div class="deps-body">
				if r.Base != nil {
					<ul class="deps-rows deps-base" aria-label={ "Patch and minor updates of " + r.Repo }>
						@inboxDepsRow(*r.Base)
					</ul>
				}
				if len(r.Majors) > 0 {
					<h3 class="deps-group-h">Majors</h3>
					<ul class="deps-rows deps-majors" aria-label={ "Major updates of " + r.Repo }>
						for _, d := range r.Majors {
							@inboxDepsRow(d)
						}
					</ul>
				}
			</div>
		</details>
		<span class="deps-repo-act">
			<a id={ r.ID + "-repo" } class="btn icon" href={ templ.SafeURL(r.RepoHref) } aria-label={ "Open repository " + r.Repo } title={ "open " + r.Repo }><span class="ico i-link" aria-hidden="true"></span></a>
			if r.Recheck != "" {
				@depsForm(InboxDepsRow{}, r.Recheck, "Re-check", "btn", false, r.ID+"-recheck")
				<details class="menu deps-menu">
					<summary id={ r.ID + "-more" } class="btn icon" aria-label={ "More actions for " + r.Repo }>⋯</summary>
					<div class="menu-pop">
						if r.AutoOn {
							@depsFieldForm(r.Auto, "on", "0", "Auto-open off")
						} else {
							@depsFieldForm(r.Auto, "on", "1", "Auto-open on")
						}
						@depsForm(InboxDepsRow{}, r.Snooze, "Snooze", "btn", false, "")
					</div>
				</details>
			}
		</span>
	</li>
}

// depsFailure is the failure of a batch: the full reason, the commands that
// redo it by hand, and the link to the log.
templ depsFailure(d InboxDepsRow) {
	<div class="deps-failure" role="region" aria-label={ "Failure of " + d.Title }>
		if d.Status.Adopted {
			<p class="dim deps-adopted-note">The branch was changed by hand: Bernard no longer retries it. Fix it in the merge request.</p>
		}
		<pre class="deps-error">{ d.Status.Title }</pre>
		if d.Repro != "" {
			<p class="dim">Reproduce locally:</p>
			<pre class="deps-repro">{ d.Repro }</pre>
		}
		if d.Status.Href != "" {
			<a id={ d.ID + "-log" } href={ templ.SafeURL(d.Status.Href) }>View log · { d.Status.Text }</a>
		}
	</div>
}

templ inboxDepsRow(d InboxDepsRow) {
	<li class={ "deps-row", templ.KV("deps-major", d.Major) } id={ d.ID } data-failed?={ d.Status.Kind == "failed" }>
		<details class="deps-batch">
			<summary id={ d.ID + "-sum" }>
				<span class="deps-title">{ d.Title }</span>
				if d.Packages != "" {
					<span class="deps-pkgs dim">{ d.Packages }</span>
				}
				if d.Target != "" {
					<span class="deps-target">→ { d.Target }</span>
				}
				if d.Outdated {
					<span class="pill">outdated</span>
				}
				<span class="count">{ itoa(d.Count) }</span><span class="sr">{ " updates" }</span>
				if !d.Major {
					<span class="dim">{ d.Breakdown }</span>
				}
				if d.New > 0 {
					<span class="pill deps-new">new { itoa(d.New) }</span>
				}
			</summary>
			<table class="deps-sub" aria-label={ "Updates of " + d.Repo + ": " + d.Title }>
				<thead class="sr">
					<tr><th>name</th><th>version</th><th>kind</th><th>new</th><th>directory</th></tr>
				</thead>
				<tbody>
					for _, u := range d.Updates {
						<tr>
							<td><code>{ u.Name }</code></td>
							<td>{ u.Current } → { u.Latest }</td>
							<td class="dim">{ u.Kind }</td>
							<td>
								if u.New {
									<span class="pill">new</span>
								}
							</td>
							<td class="mute">{ u.Directory }</td>
						</tr>
					}
				</tbody>
			</table>
		</details>
		<span class="deps-status">
			@depsStatusCell(d.Status)
		</span>
		<span class="deps-act">
			if d.Primary.Href != "" {
				<a id={ d.ID + "-act" } class="btn primary" href={ templ.SafeURL(d.Primary.Href) }>{ d.Primary.Label }</a>
			} else if d.Primary.Action != "" {
				@depsForm(d, d.Primary.Action, d.Primary.Label, "btn primary", true, d.ID+"-act")
			}
			if d.Ignore != "" || len(d.Splits) > 0 {
				<details class="menu deps-menu">
					<summary id={ d.ID + "-more" } class="btn icon" aria-label={ "More actions for " + d.Title }>⋯</summary>
					<div class="menu-pop">
						if d.Ignore != "" {
							@depsForm(d, d.Ignore, "Ignore", "btn", true, "")
						}
						for _, sp := range d.Splits {
							@ActionForm(ActionProps{Action: sp.Action}) {
								<input type="hidden" name="ecosystem" value={ sp.Ecosystem }/>
								<input type="hidden" name="name" value={ sp.Name }/>
								<input type="hidden" name="split" value={ boolFlag(sp.Split) }/>
								<button type="submit" class="btn">{ sp.Label }</button>
							}
						}
					</div>
				</details>
			}
		</span>
		if d.Status.Title != "" {
			@depsFailure(d)
		}
	</li>
}

templ inboxModerated(id string, count int) {
	@RemoveEl(id)
	@CountOOB("inbox-pending-count", count)
}

templ inboxDepsChanged(p InboxPage) {
	<hx-partial hx-target="#inbox-deps" hx-swap="outerMorph">@InboxDeps(p)</hx-partial>
}
