package web

// Inbox is the owner's inbox: what is open across every repository. The
// counters, the filter and the lists are fragments with an id that the live
// stream replaces as a whole (ermiteLive.swap).
templ Inbox(l Layout, p InboxPage) {
	@Shell(l, nil) {
		<h1 class="sr">Inbox</h1>
		<div class="inbox">
			@InboxCounters(p)
			@InboxRepos(p)
			@InboxPending(p)
			@InboxRuns(p)
			@InboxDeps(p)
			@InboxMRs(p)
			@InboxIssues(p)
			@InboxJournal(p)
		</div>
	}
}

// InboxJournal is the activity of the range, newest first: the repositories
// whose default branch is ahead of their nearest tag, then one row per entry.
// Plain lines and a plain table, like the other sections.
templ InboxJournal(p InboxPage) {
	{{ j := p.Journal }}
	<section id="inbox-journal" class="journal" aria-labelledby="inbox-journal-h">
		<div class="journal-head">
			<h2 id="inbox-journal-h" class="rule-h"><span>Activity</span><span class="journal-count">{ itoa(len(j.Rows)) }</span></h2>
			<nav class="journal-range" aria-label="Activity range">
				for i, r := range j.Ranges {
					<a
						href={ templ.SafeURL(r.Href) }
						if r.Current {
							aria-current="page"
						}
					>{ r.Label }</a>
					if i < len(j.Ranges)-1 {
						<span class="mute" aria-hidden="true">·</span>
					}
				}
			</nav>
		</div>
		if len(j.Unreleased) > 0 {
			<ul class="unreleased" aria-label="Unreleased commits">
				for _, u := range j.Unreleased {
					<li>
						<span class="u-mark" aria-hidden="true">⚠</span>
						<a class="u-repo" href={ templ.SafeURL(u.RepoHref) }>{ u.Repo }</a>
						<span class="mute">—</span>
						<a class="num" href={ templ.SafeURL(u.CommitsHref) }>{ u.Commits }</a>
						if u.Tag != "" {
							<span class="dim">since</span> <a class="u-tag" href={ templ.SafeURL(u.TagHref) }>{ u.Tag }</a>
							if u.WhenAt != "" {
								<span class="mute">·</span> <time class="dim" datetime={ u.WhenAt } title={ u.Title }>{ u.When }</time>
							}
						} else {
							<span class="dim">since the last tag</span>
						}
					</li>
				}
			</ul>
		}
		if len(j.Rows) > 0 {
			<table class="list journal-list" aria-label="Activity">
				<thead><tr><th>When</th><th>Repository</th><th>Type</th><th class="c-main">Detail</th><th class="c-who">Actor</th></tr></thead>
				<tbody>
					for _, r := range j.Rows {
						<tr data-kind={ r.Kind }>
							<td class="c-when nowrap dim">
								if r.WhenAt != "" {
									<time datetime={ r.WhenAt } title={ r.Title }>{ r.When }</time>
								}
							</td>
							<td class="c-repo"><a href={ templ.SafeURL(r.RepoHref) }>{ r.Repo }</a></td>
							<td class="c-kind"><span class="j-kind">{ r.Label }</span></td>
							<td class="c-main">
								if r.Href != "" {
									<a href={ templ.SafeURL(r.Href) }><span class="j-ref">{ r.Ref }</span> { r.Text }</a>
								} else {
									<span class="j-ref">{ r.Ref }</span> { r.Text }
								}
								if r.Note != "" {
									<span class="mute num">· { r.Note }</span>
								}
							</td>
							<td class="c-who mute">{ r.Actor }</td>
						</tr>
					}
				</tbody>
			</table>
			if j.Truncated {
				<p class="mute journal-more">only the latest { itoa(len(j.Rows)) } entries are shown.</p>
			}
		} else {
			<p class="lede dim">no activity in the last { j.RangeLabel }.</p>
		}
	</section>
}

templ InboxCounters(p InboxPage) {
	<p id="inbox-counts" class="inbox-counts">
		<strong>{ itoa(p.MergeRequests) }</strong> merge requests · <strong>{ itoa(p.Issues) }</strong> issues · <strong>{ itoa(p.PendingCount) }</strong> awaiting moderation · <strong>{ itoa(p.Running) }</strong> running · <strong>{ itoa(p.DepsCount) }</strong> dependency updates
	</p>
}

templ InboxRepos(p InboxPage) {
	<nav id="inbox-repos" class="since" aria-label="Repository">
		for _, r := range p.Repos {
			<a
				href={ templ.SafeURL(r.Href) }
				if r.Current {
					aria-current="page"
				}
			>{ r.Label }</a>
		}
	</nav>
}

// InboxPending is the issues awaiting moderation, first on the page. Their
// texts come from anonymous visitors: they are shown as plain text, escaped,
// never as Markdown.
templ InboxPending(p InboxPage) {
	<section id="inbox-pending" aria-labelledby="inbox-pending-h">
		<h2 id="inbox-pending-h" class="rule-h"><span>Awaiting moderation</span><span class="count">{ itoa(p.PendingCount) }</span></h2>
		if len(p.Pending) > 0 {
			<ul class="pending-list">
				for _, m := range p.Pending {
					<li class="pending">
						<div class="p-head">
							<a href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a>
							<span>{ m.Author }</span>
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</div>
						<p class="p-title">{ m.Title }</p>
						if m.Preview != "" {
							<p class="p-body">{ m.Preview }</p>
						}
						if m.Approve != "" {
							<div class="p-btns">
								<form method="post" action={ templ.SafeURL(m.Approve) }><button type="submit" class="btn primary">Approve</button></form>
								<form method="post" action={ templ.SafeURL(m.Reject) }><button type="submit" class="btn">Reject</button></form>
								<form method="post" action={ templ.SafeURL(m.Ban) }><button type="submit" class="btn danger">Reject and ban</button></form>
							</div>
						}
					</li>
				}
			</ul>
		} else {
			<p class="lede dim">nothing awaits moderation.</p>
		}
	</section>
}

templ InboxMRs(p InboxPage) {
	<section id="inbox-mrs" aria-labelledby="inbox-mrs-h">
		<h2 id="inbox-mrs-h" class="rule-h"><span>Open merge requests</span><span class="count">{ itoa(len(p.MRs)) }</span></h2>
		@inboxRows(p.MRs, "Open merge requests")
		if len(p.MRs) == 0 {
			<p class="lede dim">no open merge requests.</p>
		}
	</section>
}

templ InboxIssues(p InboxPage) {
	<section id="inbox-issues" aria-labelledby="inbox-issues-h">
		<h2 id="inbox-issues-h" class="rule-h"><span>Open issues</span><span class="count">{ itoa(len(p.IssueRows)) }</span></h2>
		@inboxRows(p.IssueRows, "Open issues")
		if len(p.IssueRows) == 0 {
			<p class="lede dim">no open issues.</p>
		}
	</section>
}

templ inboxRows(rows []InboxRow, label string) {
	if len(rows) > 0 {
		<table class="list mrs" aria-label={ label }>
			<tbody data-rows>
				for _, m := range rows {
					<tr data-cursor?={ m.Cursor } data-state="open">
						<td class="c-n mute">{ m.Number }</td>
						<td class="c-subject"><a href={ templ.SafeURL(m.Href) }>{ m.Title }</a> <a class="mute" href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a></td>
						<td class="c-ck">@CommitChecks(m.Checks)</td>
						<td class="c-when nowrap dim">
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// InboxRuns stays as an empty fragment when CI is disabled.
templ InboxRuns(p InboxPage) {
	<section id="inbox-runs" hidden?={ !p.RunsEnabled }
        if p.RunsEnabled {
            aria-labelledby="inbox-runs-h"
        }
    >
		if p.RunsEnabled {
			<h2 id="inbox-runs-h" class="rule-h"><span>Running</span><span class="count">{ itoa(len(p.Runs)) }</span></h2>
			if len(p.Runs) == 0 {
				<p class="lede dim">no runs in progress.</p>
			} else {
				<table class="list mrs" aria-label="Running">
					<tbody data-rows>
						for _, r := range p.Runs {
							<tr>
								<td class="c-st">@CheckIcon(r.Kind, r.State)<span class="dim">{ r.State }</span></td>
								<td class="c-subject"><a href={ templ.SafeURL(r.Href) }>{ r.Workflow }{ " " }{ r.Number }</a> <a class="mute" href={ templ.SafeURL(r.RepoHref) }>{ r.Repo }</a> <span class="dim">{ r.Ref }{ " " }{ r.Event }</span></td>
								<td class="c-when nowrap dim">
									if r.WhenAt != "" {
										<time datetime={ r.WhenAt } title={ r.WhenAt }>{ r.When }</time>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</section>
}

// InboxDeps is Bernard's table: one row per repository with pending updates, a
// disclosure for its updates, the status of its run or merge request, and the
// actions. It stays as an empty fragment when there is nothing to show.
// data-keep-open: the live swap keeps the open rows open.
templ InboxDeps(p InboxPage) {
	<section
		id="inbox-deps"
		data-keep-open
		hidden?={ len(p.Deps) == 0 }
		if len(p.Deps) > 0 {
			aria-labelledby="inbox-deps-h"
		}
	>
		if len(p.Deps) > 0 {
			<h2 id="inbox-deps-h" class="rule-h">
				<span>Dependency updates</span>
				<span class="dim">
					if p.DepsCheckedAt != "" {
						checked <time datetime={ p.DepsCheckedAt }>{ p.DepsChecked }</time> ·{ " " }
					}
					{ plural(len(p.Deps), "repo", "repos") } · { plural(p.DepsUpdates, "update", "updates") }
				</span>
			</h2>
			<ul class="deps-rows">
				for _, d := range p.Deps {
					<li class="deps-row" id={ d.ID }>
						<details class="deps-main">
							<summary id={ d.ID + "-sum" }>
								<span class="deps-repo">{ d.Repo }</span>
								<span class="count">{ itoa(d.Count) }</span><span class="sr">{ " updates" }</span>
								<span class="dim">{ d.Breakdown }</span>
								if d.New > 0 {
									<span class="pill deps-new">new { itoa(d.New) }</span>
								}
							</summary>
							if d.Status.Title != "" {
								<div class="deps-output prose" role="region" aria-label="Last output">
									<p class="dim">Last output</p>
									<pre>{ d.Status.Title }</pre>
									if d.Status.Href != "" {
										<a id={ d.ID + "-log" } href={ templ.SafeURL(d.Status.Href) }>View log · { d.Status.Text }</a>
									}
								</div>
							}
							<p class="deps-repolink"><a href={ templ.SafeURL(d.RepoHref) }>{ d.Repo }</a></p>
							<table class="deps-sub" aria-label={ "Updates of " + d.Repo }>
								<thead class="sr">
									<tr><th>name</th><th>version</th><th>kind</th><th>new</th><th>directory</th></tr>
								</thead>
								<tbody>
									for _, u := range d.Updates {
										<tr>
											<td><code>{ u.Name }</code></td>
											<td>{ u.Current } → { u.Latest }</td>
											<td class="dim">{ u.Kind }</td>
											<td>
												if u.New {
													<span class="pill">new</span>
												}
											</td>
											<td class="mute">{ u.Directory }</td>
										</tr>
									}
								</tbody>
							</table>
						</details>
						<span class="deps-status">
							@depsStatusCell(d.Status)
							if d.Status.Title != "" {
								<span class="deps-error-tail" title={ d.Status.Title }>{ depsErrorTail(d.Status.Title) }</span>
							}
						</span>
						<span class="deps-act">
							if d.Primary.Href != "" {
								<a id={ d.ID + "-act" } class="btn primary" href={ templ.SafeURL(d.Primary.Href) }>{ d.Primary.Label }</a>
							} else if d.Primary.Action != "" {
								@depsForm(d, d.Primary.Action, d.Primary.Label, "btn primary", true, d.ID+"-act")
							}
							if d.Ignore != "" || d.Snooze != "" {
								<details class="menu deps-menu">
									<summary id={ d.ID + "-more" } class="btn icon" aria-label={ "More actions for " + d.Repo }>⋯</summary>
									<div class="menu-pop">
										if d.Ignore != "" {
											@depsForm(d, d.Ignore, "Ignore", "btn", true, "")
										}
										if d.Snooze != "" {
											@depsForm(d, d.Snooze, "Snooze", "btn", false, "")
										}
									</div>
								</details>
							}
						</span>
					</li>
				}
			</ul>
		}
	</section>
}

// depsStatusCell is the state of the run, when there is one to tell, and the
// open merge request. The failure reason is shown in the row details.
templ depsStatusCell(s InboxDepsStatus) {
	if s.State != "" {
		<span class="deps-state">
			<span aria-hidden="true">
				@CheckIcon(depsIconKind(s), s.State)
			</span>
			<span class="dim">{ s.State }</span>
			if s.Href != "" {
				<a href={ templ.SafeURL(s.Href) }>{ s.Text }</a>
			}
		</span>
	}
	if s.MR != 0 {
		<a href={ templ.SafeURL(s.MRHref) }>MR !{ itoa64(s.MR) }</a>
	}
}

// depsForm is one POST button of a row. The expected versions go in hidden
// fields (four per update, in the same order) for Open MR and Ignore.
templ depsForm(d InboxDepsRow, action, label, class string, refs bool, id string) {
	<form method="post" action={ templ.SafeURL(action) }>
		if refs {
			for _, u := range d.Updates {
				<input type="hidden" name="ecosystem" value={ u.Ecosystem }/>
				<input type="hidden" name="directory" value={ u.Directory }/>
				<input type="hidden" name="name" value={ u.Name }/>
				<input type="hidden" name="version" value={ u.Latest }/>
			}
		}
		<button
			type="submit"
			class={ class }
			if id != "" {
				id={ id }
			}
		>{ label }</button>
	</form>
}
