package web

// Shell is the page: head, the header, the work area (content and rail), the
// footer, the hint badge, the overlays and the key map. The content is the
// children.
templ Shell(l Layout, rail templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ l.Title }</title>
			<link rel="icon" type="image/svg+xml" href={ templ.SafeURL(l.Assets.Icon) }/>
			<link rel="preload" href={ templ.SafeURL(l.Assets.Font) } as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href={ templ.SafeURL(l.Assets.CSS) }/>
			<script src={ l.Assets.HTMX } defer></script>
			<script src={ l.Assets.Live } defer></script>
			<script src={ l.Assets.SSE } defer></script>
			<script src={ l.Assets.App } defer></script>
		</head>
		<body data-ref={ l.RefPath } data-sha={ l.SHA } data-sel="" data-nav="">
			<a class="skip" href="#main">skip to content</a>
			@Header(l)
			<div class={ "work", templ.KV("has-rail", l.HasRail && rail != nil) }>
				<main id="main" tabindex="-1">
					{ children... }
				</main>
				if l.HasRail && rail != nil {
					<aside class="rail" aria-label="Context">
						@rail
					</aside>
				}
			</div>
			@Footer(l)
			@Hint(l)
			@OverlayHelp()
			@OverlayRefs(l)
			@OverlayCmd(l.Cmd)
			@Keys()
		</body>
	</html>
}

// Header is the page header: the instance, the path, the ref switcher, the
// "go to" palette and the owner; inside a repository, the tabs below.
templ Header(l Layout) {
	<header class="hdr">
		<div class="hdr-top">
			<a class="brand" href="/" data-g="h" title="home (g h)">
				<span class="brand-mark" aria-hidden="true"></span>
				<span class="brand-name">{ l.Instance }</span>
			</a>
			if len(l.Crumbs) > 0 {
				<nav class="crumbs" aria-label="Path">
					<ol>
						for _, c := range l.Crumbs {
							<li>
								if c.Href != "" {
									<a
										href={ templ.SafeURL(c.Href) }
										if c.Current {
											aria-current="page"
										}
									>{ c.Label }</a>
								} else {
									<span
										if c.Current {
											aria-current="page"
										}
									>{ c.Label }</span>
								}
							</li>
						}
					</ol>
				</nav>
			}
			<div class="hdr-acts">
				if l.Ref != "" {
					<button
						type="button"
						class="btn ref"
						aria-haspopup="dialog"
						aria-controls="panel-refs"
						aria-keyshortcuts="b"
						title="switch branch or tag (b)"
						hx-on:click="document.body.dispatchEvent(new CustomEvent('k-refs'))"
					>
						<span class="ico i-branch" aria-hidden="true"></span>
						<span class="ref-name">{ l.Ref }</span>
						<span class="sha">{ l.Short }</span>
					</button>
				}
				<button
					type="button"
					class="btn search"
					aria-haspopup="dialog"
					aria-controls="panel-cmd"
					aria-keyshortcuts="Control+K :"
					title="go to a section, ref, file or repo (ctrl k or :)"
					hx-on:click="document.body.dispatchEvent(new CustomEvent('k-cmd'))"
				>
					<span class="ico i-search" aria-hidden="true"></span>
					<span class="search-label">Go to…</span>
					<kbd aria-hidden="true">ctrl k</kbd>
				</button>
				<button type="button" class="btn icon" aria-haspopup="dialog" aria-controls="panel-help" aria-keyshortcuts="?" aria-label="Keyboard shortcuts" title="keyboard shortcuts (?)" hx-on:click="document.body.dispatchEvent(new CustomEvent('k-help'))">?</button>
				if SignedIn(ctx) {
					<form class="owner" method="post" action="/-/logout">
						<span class="owner-badge" title="signed in as the owner">owner</span>
						<button type="submit" class="btn" title="sign out of this browser">Sign out</button>
					</form>
				}
			</div>
		</div>
		if len(l.Sections) > 0 {
			<nav class="tabs" aria-label="Sections">
				<ul>
					for _, s := range l.Sections {
						<li>
							<a
								href={ templ.SafeURL(s.Href) }
								data-key={ s.Key }
								aria-keyshortcuts={ s.Key }
								if s.Current {
									aria-current="page"
								}
							>{ s.Label }<kbd aria-hidden="true">{ s.Key }</kbd></a>
						</li>
					}
				</ul>
			</nav>
		}
	</header>
}

// Footer is the version and the link to the source of the running version,
// which the AGPL §13 asks every user of the service to be offered.
templ Footer(l Layout) {
	<footer class="foot">
		<span>ermite { l.Version }</span>
		<a href={ templ.SafeURL(l.SourceURL) } rel="noopener" title="source of this version (AGPL-3.0-or-later)">source</a>
		<span class="foot-keys"><kbd>?</kbd> keyboard shortcuts</span>
	</footer>
}

// Hint is the floating badge at the bottom right. It shows only what the
// keyboard just did or what needs attention: the row position while j/k
// move, the selected lines of a file, a flash message (permalink copied) and
// a lost event stream. Empty, it takes no room.
templ Hint(l Layout) {
	<div class="hint" role="status" aria-live="polite">
		<span class="hint-nav" :text="document.body.dataset.nav || ''"></span>
		<span class="hint-sel" :text="document.body.dataset.sel ? document.body.dataset.sel + ' · y permalink' : ''"></span>
		<span class="hint-flash" :text="document.body.dataset.flash || ''"></span>
		@Live(l)
	</div>
}
