package web

import (
	"strconv"
	"strings"
)

// OverlayHelp is the keyboard map panel; the keys of the merge request page
// show on that page only.
templ OverlayHelp(mr bool) {
	<dialog id="panel-help" class="panel modal" aria-label="Keyboard shortcuts" hx-on:keydown="event.key === 'Escape' && (event.preventDefault(), this.close())" hx-on:click="event.target === this && this.close()">
		<div class="panel-head"><h2>Keyboard shortcuts</h2><button type="button" class="panel-x" aria-label="Close (esc)" hx-on:click="closest('dialog').close()"><kbd>esc</kbd> close</button></div>
		<div class="keys-pref">
			<label><input type="checkbox" id="keys-off" aria-describedby="keys-note" hx-on:change="ermite.setKeysOff(this.checked)"/> Turn off single-key shortcuts</label>
			<p id="keys-note" class="dim">Single-key shortcuts are on. ctrl k and esc work whatever this says.</p>
		</div>
		<dl class="keys">
			<div><dt><kbd>ctrl k</kbd> <kbd>:</kbd></dt><dd>go to a section, branch, tag, file or repository</dd></div>
			<div><dt><kbd>?</kbd></dt><dd>this list</dd></div>
			<div><dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>move the row cursor down / up</dd></div>
			<div><dt><kbd>enter</kbd></dt><dd>open the row under the cursor; on Files, a directory opens or closes in place</dd></div>
			<div><dt><kbd>↑</kbd> <kbd>↓</kbd> <kbd>←</kbd> <kbd>→</kbd> <kbd>home</kbd> <kbd>end</kbd></dt><dd>in the file tree (focus on a row): previous / next row, close / open a directory or go to its parent / first entry, first / last row. They never open a file</dd></div>
			<div><dt><kbd>l</kbd> <kbd>h</kbd></dt><dd>on Files: open a directory or a file / close a directory or go up to its parent, then to the parent page. On pages with a side panel: into the panel (on a merge request, its files) / back to the content; there j k move between its controls</dd></div>
			<div><dt><kbd>g g</kbd> <kbd>G</kbd></dt><dd>first / last row</dd></div>
			<div><dt><kbd>/</kbd></dt><dd>filter the list; on Files, find a file anywhere in the repository (esc clears, enter opens the best match)</dd></div>
			<div><dt><kbd>b</kbd></dt><dd>{ "switch" } branch or tag</dd></div>
			<div><dt><kbd>g s</kbd> <kbd>g f</kbd> <kbd>g c</kbd> <kbd>g b</kbd> <kbd>g m</kbd> <kbd>g i</kbd> <kbd>g r</kbd> <kbd>g a</kbd></dt><dd>tabs: summary, files, commits, branches &amp; tags, merge requests, issues, releases, actions (when available)</dd></div>
			if SignedIn(ctx) {
				<div><dt><kbd>I</kbd></dt><dd>inbox</dd></div>
			}
			<div><dt><kbd>g h</kbd></dt><dd>home</dd></div>
			<div><dt><kbd>w</kbd></dt><dd>wide mode: use the whole width of the screen, or not (remembered)</dd></div>
			<div><dt><kbd>y</kbd></dt><dd>copy a permalink pinned to the commit</dd></div>
			<div><dt><kbd>d</kbd> <kbd>u</kbd> <kbd>x</kbd></dt><dd>diff: split / unified / collapse or expand all</dd></div>
			<div><dt><kbd>e</kbd> <kbd>E</kbd></dt><dd>diff: the whole file in view / every file, with the lines the hunks hide</dd></div>
			<div><dt><kbd>n</kbd></dt><dd>merge request: next note in the diff</dd></div>
			if mr {
				<div><dt><kbd>l</kbd></dt><dd>merge request: the list of files (j k move, enter opens, esc back)</dd></div>
				<div><dt><kbd>M</kbd></dt><dd>merge request: the merge menu; there 1–3 pick the mode, D deletes the branch, enter merges</dd></div>
				<div><dt><kbd>R</kbd></dt><dd>merge request: mark the head read</dd></div>
			}
			<div><dt><kbd>esc</kbd></dt><dd>close a dialog, leave a field</dd></div>
		</dl>
	</dialog>
}

// OverlayRefs is the ref switcher. It exists only inside a repository.
templ OverlayRefs(l Layout) {
	if l.Ref != "" {
		<dialog id="panel-refs" class="panel modal" aria-label="Switch ref" hx-on:keydown="event.key === 'Escape' && (event.preventDefault(), this.close())" hx-on:click="event.target === this && this.close()">
			<div class="panel-head">
				<label for="refs-filter" class="sr">filter branches and tags</label>
				<input
					id="refs-filter"
					type="search"
					placeholder="Switch branch or tag…"
					autocomplete="off"
					data-pick="#panel-refs li"
					hx-on:input="ermite.filter(this)"
				/>
				<button type="button" class="panel-x" aria-label="Close (esc)" hx-on:click="closest('dialog').close()"><kbd>esc</kbd></button>
			</div>
			<div class="panel-cols" data-picklist>
				<section aria-label="Branches">
					<h2>Branches <span class="count">{ itoa(len(l.Heads)) }</span></h2>
					<ul>
						for _, r := range l.Heads {
							@refItem(r)
						}
					</ul>
				</section>
				<section aria-label="Tags">
					<h2>Tags <span class="count">{ itoa(len(l.Tags)) }</span></h2>
					<ul>
						for _, r := range l.Tags {
							@refItem(r)
						}
					</ul>
				</section>
			</div>
		</dialog>
	}
}

templ refItem(r RefItem) {
	<li>
		<a
			href={ templ.SafeURL(r.Href) }
			if r.Current {
				aria-current="true"
			}
		>
			<span class="mark" aria-hidden="true">
				if r.Current {
					●
				} else {
					&nbsp;
				}
			</span>{ r.Name }
		</a>
	</li>
}

// OverlayCmd is the ":" command line: one filterable list mixing sections,
// refs and repos.
templ OverlayCmd(items []CmdItem) {
	<dialog id="panel-cmd" class="panel modal" aria-label="Go to" hx-on:close="ermiteFinder.paletteClose()" hx-on:keydown="event.key === 'Escape' && (event.preventDefault(), this.close())" hx-on:click="event.target === this && this.close()">
		<div class="panel-head">
			<label for="cmd-q" class="sr">go to</label>
			<input
				id="cmd-q"
				type="search"
				placeholder="Go to a section, branch, tag, file or repository…"
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-autocomplete="list"
				aria-expanded="true"
				aria-controls="cmd-list"
				aria-activedescendant="cmd-o0"
				hx-on:input="ermite.cmdFilter(this); ermiteFinder.palette(this)"
				hx-on:keydown="ermite.cmdKey(event)"
			/>
			<button type="button" class="panel-x" aria-label="Close (esc)" hx-on:click="closest('dialog').close()"><kbd>esc</kbd></button>
		</div>
		<ul id="cmd-list" class="cmd-list" role="listbox" aria-label="Targets">
			for i, c := range items {
				<li id={ "cmd-o" + itoa(i) } role="option" aria-selected={ strconv.FormatBool(i == 0) } data-k={ strings.ToLower(c.Kind + " " + c.Label) } data-cursor?={ i == 0 }><a role="presentation" data-href={ c.Href }><span class="lbl">{ c.Label }</span><span class="k">{ c.Kind }</span></a></li>
			}
			<li id={ "cmd-o" + itoa(len(items)) } role="option" aria-selected={ strconv.FormatBool(len(items) == 0) } data-cursor?={ len(items) == 0 } data-k="action turn single-key shortcuts on off keyboard"><a role="presentation" data-fire="keys"><span class="lbl">turn single-key shortcuts off</span><span class="k">action</span></a></li>
		</ul>
		<p class="panel-foot"><span><kbd>↑</kbd><kbd>↓</kbd> move</span><span><kbd>enter</kbd> open</span><span><kbd>esc</kbd> close</span></p>
	</dialog>
}
