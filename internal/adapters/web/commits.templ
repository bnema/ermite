package web

// Commits is the history of a ref, or of a path at a ref: the commits of the
// page grouped by day, and the way to the older ones.
templ Commits(l Layout, p CommitsPage) {
	@Shell(l, commitsRail(p)) {
		<div class="filter">
			<label for="commit-filter" class="sr">filter</label>
			<input
				id="commit-filter"
				type="search"
				data-filter=".days tr"
				data-groups=".days section"
				placeholder="Filter by subject, sha or author…"
				autocomplete="off"
				hx-on:input="ermite.filter(this)"
			/>
		</div>
		if p.Path != "" {
			<p class="lede dim">history of <code>{ p.Path }</code> at { p.Ref }</p>
		}
		if p.Live {
			@LiveSlot("commits-head")
		}
		<div class="days">
			for _, g := range p.Days {
				<section aria-label={ g.Day }>
					<h2 class="rule-h"><span>{ g.Day }</span></h2>
					@CommitRows(g.Rows)
				</section>
			}
		</div>
		if len(p.Days) == 0 {
			<p class="lede dim">no commits.</p>
		}
		if p.Older != "" || p.Newest != "" {
			<nav class="pager" aria-label="Pages">
				if p.Newest != "" {
					<a class="btn" href={ templ.SafeURL(p.Newest) }>← Newest</a>
				} else {
					<span class="btn" aria-disabled="true">← Newest</span>
				}
				if p.Older != "" {
					<a class="btn" href={ templ.SafeURL(p.Older) } rel="next">Older →</a>
				} else {
					<span class="btn" aria-disabled="true">Older →</span>
				}
			</nav>
		}
	}
}

templ commitsRail(p CommitsPage) {
	<section aria-labelledby="r-hist">
		<h2 id="r-hist">History</h2>
		<p class="h-ref"><span class="ico i-branch" aria-hidden="true"></span><span class="h-name">{ p.Ref }</span></p>
		<ul class="h-stats">
			<li><b>{ itoa(p.Count) }</b> { noun(p.Count, "commit", "commits") }</li>
			<li><b>{ itoa(p.Authors) }</b> { noun(p.Authors, "author", "authors") }</li>
		</ul>
		if p.From != "" {
			<p class="h-dates">
				if p.From == p.To {
					{ p.From }
				} else {
					{ p.From } → { p.To }
				}
			</p>
		}
		if p.Path != "" || p.Open != nil {
			<dl class="kv">
				if p.Path != "" {
					<dt>path</dt>
					<dd>{ p.Path }</dd>
				}
				if p.Open != nil {
					<dt>file</dt>
					<dd><a href={ templ.SafeURL(p.Open.Href) }>{ p.Open.Label }</a></dd>
				}
			</dl>
		}
	</section>
	<section aria-labelledby="r-refs">
		<h2 id="r-refs">Refs on this page <span class="count">{ itoa(len(p.Refs)) }</span></h2>
		if len(p.Refs) > 0 {
			<nav class="page-refs" aria-label="Refs on this page">
				for _, r := range p.Refs {
					<a href={ templ.SafeURL(r.Href) }>
						if r.Tag {
							<span class="ico i-tag" aria-hidden="true"></span>
							<span class="sr">tag </span>
						} else {
							<span class="ico i-branch" aria-hidden="true"></span>
							<span class="sr">branch </span>
						}
						<span class="pr-name">{ r.Name }</span>
						<span class="pr-meta"><code>{ r.Short }</code> · { r.When }</span>
					</a>
				}
			</nav>
		} else {
			<p class="dim">no tag or branch head here</p>
		}
	</section>
}
