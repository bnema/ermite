package web

// Work is the owner's open merge requests and issues.
templ Work(l Layout, p WorkPage) {
	@Shell(l, nil) {
		<div id="view" data-view="work">
			<h1 class="sr" tabindex="-1">Work</h1>
			@WorkMRs(p)
			@WorkIssues(p)
		</div>
	}
}

templ WorkMRs(p WorkPage) {
	<section id="work-mrs" aria-labelledby="work-mrs-h">
		<h2 id="work-mrs-h" class="rule-h"><span>Open merge requests</span><span class="count">{ itoa(len(p.MRs)) }</span></h2>
		@workTable(p.MRs, "Open merge requests")
		if len(p.MRs) == 0 {
			<p class="lede dim">no open merge requests.</p>
		}
	</section>
}

templ WorkIssues(p WorkPage) {
	<section id="work-issues" aria-labelledby="work-issues-h">
		<h2 id="work-issues-h" class="rule-h"><span>Open issues</span><span class="count">{ itoa(len(p.Issues)) }</span></h2>
		@workTable(p.Issues, "Open issues")
		if len(p.Issues) == 0 {
			<p class="lede dim">no open issues.</p>
		}
	</section>
}

templ workTable(rows []WorkRow, label string) {
	if len(rows) > 0 {
		<table class="list mrs" aria-label={ label }>
			<tbody data-rows>
				for _, m := range rows {
					<tr data-cursor?={ m.Cursor } data-state="open">
						<td class="c-n mute">{ m.Number }</td>
						<td class="c-subject"><a href={ templ.SafeURL(m.Href) }>{ m.Title }</a> <a class="mute" href={ templ.SafeURL(m.RepoHref) }>{ m.Repo }</a></td>
						<td class="c-ck">@CommitChecks(m.Checks)</td>
						<td class="c-when nowrap dim">
							if m.WhenAt != "" {
								<time datetime={ m.WhenAt } title={ m.WhenAt }>{ m.When }</time>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
